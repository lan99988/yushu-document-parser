# Bind the API only to this host's Tailscale IPv4 address, such as 100.x.y.z.
TAILSCALE_IP=100.64.0.10

# MinerU 4 downloads model files on first parse. ModelScope is a convenient
# default for many users in China; set huggingface if that is your preference.
MINERU_MODEL_SOURCE=modelscope
MINERU_TIER=standard

# Optional API key. Use the same value as DOCUMENT_PARSER_REMOTE_TOKEN on the
# Windows MCP client. If blank, access is restricted by the Tailscale network.
MINERU_API_KEY=

# Portable CPU build. For GPU, choose the full MinerU runtime and a PyTorch
# wheel index compatible with the server's driver, for example an official cu12x index.
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
MINERU_IMAGE=document-parser-mineru:4.0.7
