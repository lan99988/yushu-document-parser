# Bind the API only to this host's Tailscale IPv4 address, such as 100.x.y.z.
TAILSCALE_IP=100.64.0.10

# MinerU downloads models on first parse. ModelScope is a convenient default
# for many users in China; set huggingface if that is your preferred source.
MINERU_MODEL_SOURCE=modelscope
MINERU_API_TASK_RETENTION_SECONDS=86400

# Portable CPU build. For GPU, choose a PyTorch wheel index compatible with
# the server's driver, for example an official cu12x index.
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
MINERU_IMAGE=document-parser-mineru:3.2.3
